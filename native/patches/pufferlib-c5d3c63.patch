+// ---- league routing (opt-in via hypers.league_routing) ----
+// The env stamps a frozen-bank id (0 = learner) into one obs column on rows
+// where a frozen opponent is to act; the env exports which column via this
+// weak symbol (same pattern as env_head_consume_map).
+extern "C" __attribute__((weak)) int env_league_tag_col(void);
+
+// Pull the tag out of the observation into its own rollout tensor and zero
+// the column: every checkpoint trained with this column at 0, so no forward
+// (primary, frozen, or train) may see a nonzero value.
+__global__ void league_extract_tag_kernel(precision_t* __restrict__ obs,
+        precision_t* __restrict__ tag_out, int rows, int obs_size, int col) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= rows) return;
+    long o = (long)i * obs_size + col;
+    tag_out[i] = obs[o];
+    obs[o] = from_float(0.0f);
+}
+
+// Overwrite the rows this bank's tag claims with the bank's sampled action +
+// logprob. Values are deliberately NOT merged: the primary's critic prices
+// every row, so league games are mirror games with an external action source
+// (frozen critics never leak into GAE).
+__global__ void league_merge_kernel(precision_t* __restrict__ act,
+        precision_t* __restrict__ lp,
+        const precision_t* __restrict__ s_act,
+        const precision_t* __restrict__ s_lp,
+        const precision_t* __restrict__ tag, int bank_id, int n, int num_atns) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    if ((int)(to_float(tag[i]) + 0.5f) != bank_id) return;
+    for (int h = 0; h < num_atns; h++)
+        act[(long)i * num_atns + h] = s_act[(long)i * num_atns + h];
+    lp[i] = s_lp[i];
+}
