-    for (int kh = 0; kh < K; kh++) {
-        int ih_off = ih - kh;
-        if (ih_off < 0 || ih_off % S != 0) continue;
-        int oh = ih_off / S;
-        if (oh >= OH) continue;
-        for (int kw = 0; kw < K; kw++) {
