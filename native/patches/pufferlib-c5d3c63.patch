+// Reduce one int across the ranks. op: 0 = min, 1 = max, 2 = sum.
+// Exists so python can PROVE the ranks agree before doing something that must
+// happen identically everywhere -- specifically the mid-run deck-pool swap,
+// where ranks disagreeing means deck id 57 is a different deck on different
+// ranks and both the training data and the deck matrix corrupt with no error.
+// Single-rank runs short-circuit, so callers need no world_size special-case.
+extern "C" int pufferl_allreduce_i32(PuffeRL* pufferl, int value, int op) {
+    if (pufferl->nccl_comm == nullptr || pufferl->hypers.world_size <= 1)
+        return value;
+    int* dev = nullptr;
+    if (cudaMalloc(&dev, sizeof(int)) != cudaSuccess) return value;
+    cudaMemcpy(dev, &value, sizeof(int), cudaMemcpyHostToDevice);
+    ncclRedOp_t o = (op == 0) ? ncclMin : (op == 1) ? ncclMax : ncclSum;
+    ncclResult_t nr = ncclAllReduce(dev, dev, 1, ncclInt32, o,
+                                    pufferl->nccl_comm, 0);
+    cudaStreamSynchronize(0);
+    int out = value;
+    if (nr == ncclSuccess)
+        cudaMemcpy(&out, dev, sizeof(int), cudaMemcpyDeviceToHost);
+    cudaFree(dev);
+    return out;
+}
